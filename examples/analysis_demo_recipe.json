{
  "data": {
    "operator": "labcairn.analysis.grouped_aggregate@1.0.0",
    "parameters": {
      "aggregate": "labcairn.analysis.mean@1.0.0",
      "by": "group",
      "of": "value"
    },
    "selection": {
      "source": "sources/groups.csv",
      "columns": ["group", "value"],
      "rows": {"start": 2, "end": 17},
      "missing": "exclude"
    }
  },
  "encoding": {
    "mark": "bar",
    "x": "group",
    "y": "value",
    "title": "Mean value by group",
    "x_label": "group",
    "y_label": "mean value",
    "caption": "The mean of the value column, computed once per group."
  },
  "output": {
    "format": "svg",
    "dpi": 100
  }
}
