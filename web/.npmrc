# LabCairn web app — pnpm settings (see package.json "packageManager" for the exact pnpm pin)
#
# Record exact versions in package.json so a reviewer can read the intended version
# directly from the manifest; pnpm-lock.yaml remains the resolution authority.
save-exact=true

# Fail loudly instead of silently downgrading Node/pnpm away from the pinned baseline.
# If this ever blocks a legitimate install, the fix is to escalate the pin deliberately
# (LC-P1-01 R-4), not to relax the range here.
engine-strict=true
