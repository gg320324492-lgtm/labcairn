# LabCairn — example environment file
#
# Copy to `.env` and fill in what you actually use. `.env` is gitignored; this
# file is the tracked template and must never contain a real credential.
#
# Phase 1's **default offline run reads no environment variable.** The
# FakeProvider in src/labcairn/core/providers/ is deterministic and offline,
# so `uv run pytest` passes with none of these set. **The provider layer does
# read one — but only when a workspace's `providers.json` names it**, which is
# the credential lookup, and the reason a real provider is possible at all.
# The variables below document the configuration surface that LC-P1-03 (model
# providers) will introduce, so the names are settled before any code depends
# on them.
#
# Do not put a key here. Do not commit a filled-in .env.

# --- LLM providers (LC-P1-03) -----------------------------------------------
# At least one is required before any real model call. Phase 1 acceptance runs
# entirely on FakeProvider and needs none of them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible custom endpoint (LC-P1-03). An endpoint here may silently
# ignore `tools`, which is why capability detection is checked rather than
# assumed — see docs/adr/ADR-0002.
LABCAIRN_OPENAI_COMPATIBLE_BASE_URL=
LABCAIRN_OPENAI_COMPATIBLE_API_KEY=
LABCAIRN_OPENAI_COMPATIBLE_MODEL=

# Default model when no --model is given.
LABCAIRN_DEFAULT_MODEL=

# --- Budgets (LC-P1-03) -----------------------------------------------------
# These are ceilings, not targets. A value the provider does not return is
# reported as unknown, never as zero — see ADR-0002 for why that distinction
# is load-bearing rather than pedantic.
LABCAIRN_MAX_COST_USD=
LABCAIRN_MAX_TOKENS=
LABCAIRN_MAX_TURNS=
LABCAIRN_MAX_WALL_SECONDS=

# --- Local-only escape hatch ------------------------------------------------
# Local-first means local state and artifacts, not that remote calls never
# happen. Phase 1 ships no provider adapter that can honour this; it exists so
# the name is decided once.
LABCAIRN_ALLOW_OFFLINE=

# --- Local-only development switches ---------------------------------------
# Set to 1 to make the test suite fail on any attempt to open a network socket.
# The suite already patches sockets itself; this is for debugging a leak.
LABCAIRN_FORBID_NETWORK=

# --- Local workspace --------------------------------------------------------
# The sibling upstream reference clones. Never committed, never required by CI,
# never packaged. Listed here only so the layout is documented in one place.
LABCAIRN_UPSTREAMS_DIR=
